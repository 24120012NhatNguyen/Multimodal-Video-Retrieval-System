# Chep file nay thanh .env.local roi dien gia tri that.
#   cp .env.local.example .env.local
# Next.js chi day bien co tien to NEXT_PUBLIC_ ra trinh duyet.
# SUA XONG PHAI KHOI DONG LAI `npm run dev` -- Next doc .env luc build.

# Backend tim kiem tren Kaggle. Dan URL ngrok in ra tu kaggle_run.py.
NEXT_PUBLIC_WEB_URL=http://localhost:8080

# Server trang thai + anh keyframe, chay ngay tren may nay.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8081

# De trong = dung chung voi NEXT_PUBLIC_SOCKET_URL.
NEXT_PUBLIC_MEDIA_URL=

# Server nop bai cua BTC. De trong = <socket_url>/submit.
NEXT_PUBLIC_SUBMIT_URL=
NEXT_PUBLIC_SESSION=1

# Token xac thuc tunnel (muc C5). PHAI trung voi AIC_API_TOKEN dat o backend.
# De trong ca hai ben = tat xac thuc (chi nen lam khi chay localhost).
NEXT_PUBLIC_API_TOKEN=
